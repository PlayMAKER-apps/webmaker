{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WebMAKER Studio",
  "version": "0.2.0",
  "identifier": "it.playmaker.webmaker-studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "WebMAKER Studio", "width": 1440, "height": 940, "minWidth": 900, "minHeight": 680 }],
    "security": { "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline';" }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "resources": {
      "resources/LICENSE": "LICENSE",
      "resources/NOTICE": "NOTICE",
      "../../site/content/": "starter/site/content/",
      "../../site/data/": "starter/site/data/",
      "../../site/public/": "starter/site/public/",
      "../../site/scripts/": "starter/site/scripts/",
      "../../site/tests/": "starter/site/tests/",
      "../../site/package.json": "starter/site/package.json",
      "../../site/package-lock.json": "starter/site/package-lock.json",
      "../../shared/": "starter/shared/",
      "../../.github/workflows/deploy.yml": "starter/.github/workflows/deploy.yml",
      "../../.gitignore": "starter/.gitignore",
      "../../LICENSE": "starter/LICENSE",
      "../../NOTICE": "starter/NOTICE",
      "../../starter/README.md": "starter/README.md"
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
